# Backend API base URL (không thêm dấu / ở cuối)
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Firebase Web app config (Firebase Console > Project settings > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=trustcar-c175d
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Standalone vehicle-intake API endpoint
VITE_VEHICLE_INTAKE_API_URL=http://localhost:3001/api/cpo/vehicles

# Local vehicle-intake server port
PORT=3001
