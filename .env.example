# Backend API base URL (không thêm dấu / ở cuối)
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Địa chỉ web công khai mà mã QR chứng nhận trỏ tới (không thêm / ở cuối).
# Để trống thì dùng địa chỉ đang mở trang. Khi in tem thật phải là domain public, không dùng localhost.
VITE_PUBLIC_BASE_URL=

# Firebase Web app config (Firebase Console > Project settings > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=trustcar-c175d
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
